# Copy this file to .env and fill in your own values.
# .env is git-ignored — real keys must NEVER be committed.
#
# Every example agent and the whole test suite runs with NO key set at all,
# using the built-in ScriptedProvider (see src/game/llm.py) instead of a
# real model. Set ANTHROPIC_API_KEY only when you want an example agent to
# think for itself using a live Claude model.

ANTHROPIC_API_KEY=
